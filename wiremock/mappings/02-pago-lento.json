{
    "priority": 1,
    "request": {
        "method": "POST",
        "urlPath": "/payments/validate",
        "bodyPatterns": [
            {
                "matchesJsonPath": "$[?(@.paymentMethod == 'SLOW')]"
            }
        ]
    },
    "response": {
        "status": 200,
        "fixedDelayMilliseconds": 8000,
        "headers": {
            "Content-Type": "application/json"
        },
        "jsonBody": {
            "authorizationId": "AUTH-SLOW",
            "approved": true
        }
    }
}
